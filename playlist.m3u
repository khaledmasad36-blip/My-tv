  <script>
    function onSubmit(token) {
      $('#recaptcha').val(token)
      $('#submit_code').submit()
    }

    function validate(event) {
      event.preventDefault()
      grecaptcha.execute()
    }

    function onload() {
      var element = document.getElementById('snd')
      element.onclick = validate
    }

    onload()
  </script>
