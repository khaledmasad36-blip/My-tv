<script>
(function(){
  function showMaintenance(message){
    var banner = document.getElementById('site-maintenance-banner');
    var text = document.getElementById('site-maintenance-text');
    if(text && message) text.textContent = message;
    if(banner) banner.style.display = 'flex';
  }
  fetch('http://176.123.9.60:3000/v1/admin/public')
    .then(function(r){ return r.json(); })
    .then(function(data){ if(data && data.MAINTENANCE_MODE === 'on'){ showMaintenance(data.MAINTENANCE_MESSAGE); }})
    .catch(function(){});
})();
</script>
